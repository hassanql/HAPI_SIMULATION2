# Copy to .env for local use. Required from Stage 3 onwards (GCP).
# Stage 0 (bootstrap) needs none of these.

# HuggingFace token for gated checkpoints (Qwen3.6, Gemma 4).
HF_TOKEN=hf_your_token_here

# Where to cache model weights. NEVER put this on /tmp.
# On GCP, use a >= 500 GB persistent SSD mount.
HF_HOME=/path/with/at_least_500GB_free
TRANSFORMERS_CACHE=${HF_HOME}

# A100 selection (single-GPU instance).
CUDA_VISIBLE_DEVICES=0
